<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GonzalezFExP2.About1"
             Title="About1"
             BackgroundColor="LightGray">
    <Grid Padding="20"
          RowDefinitions="*,*"
          ColumnDefinitions="*,*"
          ColumnSpacing="15"
          RowSpacing="15"
          VerticalOptions="Center"
          HorizontalOptions="Center">

        <Frame BorderColor="Gray"
               BackgroundColor="White"
               CornerRadius="10"
               HasShadow="True"
               Padding="20"
               Grid.Row="0" Grid.Column="0">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="Nombre:" FontAttributes="Bold" FontSize="30" TextColor="Black"/>
                <Label Text="Fabio Gonzalez" FontSize="18" TextColor="Black"/>
            </StackLayout>
        </Frame>
m
        <Frame BorderColor="Gray"
               BackgroundColor="White"
               CornerRadius="10"
               HasShadow="True"
               Padding="20"
               Grid.Row="0" Grid.Column="1">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="Fecha:" FontAttributes="Bold" FontSize="30" TextColor="Black"/>
                <Label Text="20/11/2003" FontSize="18" TextColor="Black"/>
            </StackLayout>
        </Frame>

        <Frame BorderColor="Gray"
               BackgroundColor="White"
               CornerRadius="10"
               HasShadow="True"
               Padding="20"
               Grid.Row="1" Grid.Column="0">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="Intereses:" FontAttributes="Bold" FontSize="30" TextColor="Black"/>
                <Label Text="Fútbol y Tecnología" FontSize="18" TextColor="Black"/>
            </StackLayout>
        </Frame>

        <Frame BorderColor="Gray"
               BackgroundColor="White"
               CornerRadius="10"
               HasShadow="True"
               Padding="20"
               Grid.Row="1" Grid.Column="1">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="Versión:" FontAttributes="Bold" FontSize="30" TextColor="Black"/>
                <Label Text="1.0" FontSize="18" TextColor="Black"/>
            </StackLayout>
        </Frame>
    </Grid>

</ContentPage>